# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://socialflow:socialflow_secret@localhost:5432/socialflow?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption
JWT_SECRET=super-secret-jwt-key-replace-in-production-12345
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Storage
STORAGE_LOCAL_ROOT=./storage

# AI Providers (Multi-provider architecture: gemini, openai, mock)
AI_ACTIVE_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Meta Facebook API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/v1/accounts/connect/meta/callback

# Video Processing (Optional override paths)
FFMPEG_PATH=
FFPROBE_PATH=
